# ─────────────────────────────────────────────
#  SECRET AGENT — Environment Configuration
# ─────────────────────────────────────────────

# Helius RPC (recommended — free tier at helius.dev)
HELIUS_API_KEY=your_helius_api_key_here
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# Fallback public RPC (used if Helius not set)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# $SAGENT Token Mint Address (set after token is deployed)
SAGENT_MINT=SAGENT_MINT_ADDRESS_HERE

# Minimum $SAGENT balance required to use the tool
SAGENT_MIN_BALANCE=1000000

# Your wallet public key (for token gate check)
OPERATOR_WALLET=YOUR_WALLET_PUBLIC_KEY_HERE

# ChangeNow known deposit wallets (comma-separated, update as needed)
# These are publicly known on-chain bridge aggregator addresses
CHANGENOW_KNOWN_WALLETS=

# Optional: Birdeye API for enriched token data
BIRDEYE_API_KEY=
